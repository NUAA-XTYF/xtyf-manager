# Python 缓存
__pycache__/
*.pyc
*.pyo

# 系统文件
Thumbs.db
.DS_Store

# 防止误传运行时数据（仅跟踪源码与文档）
*.db
*.db-wal
*.db-shm
*.db-journal
secret.key
initial-admin-password.txt
# Runtime data stays untracked; the synthetic demo generator is source.
data/*
!data/seed_demo.py

.venv/
venv/
.env
.env.*
backups/
*.sqlite*
*.log
.omo/
dist/
mail.env
data/mail-preview/

# Generated at deploy/package time, never committed.
site-release.json

# Client signing secrets and generated build resources belong to this stage.
.build-tools/
clients/signing/
clients/desktop/node_modules/
clients/desktop/target/
clients/desktop/gen/schemas/
clients/android/build/
clients/frontend/dist/
# Icons are compiled from clients/assets/aurora-logo.svg, not committed rasters.
clients/desktop/icons/icon.ico
clients/desktop/icons/128x128.png
clients/desktop/icons/256x256.png
clients/android/res/drawable-nodpi/aurora_launcher.png
# Restored on demand from npm tarballs pinned in vendor-lock.json.
clients/frontend/vendor/
client-ui-release/
clients/windows/node_modules/

# Local verification output and exact-base upgrade checkout.
.ci-main-baseline/
.coverage*
htmlcov/
coverage.xml
coverage.json
